# Generated by Cargo
target/

# Remove Cargo.lock from gitignore if creating an executable program
# More info: https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# Backup files
*.rs.bk

# IDE / Editor settings
.vscode/
.idea/
*.swp
*.swo
.claude/*
!.claude/CLAUDE.md

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Environment variables
.env*

# Telemetry runtime artifacts (anonymous instance ID files)
.anon_id
**/.anon_id

# C API build artifacts
capi/build/
capi/build-*/

# XCFramework binary (generated by capi/scripts/build_xcframework.sh; too large for git)
capi/CogneeSDK.xcframework/

# TS/Neon build artifacts (the cdylib itself now builds into bindings/target,
# already covered by the `target/` rule at the top)
ts/node_modules/
ts/lib/
ts/cognee_ts_neon.node
ts/.cognee_system/
ts/.data_storage/
ts/cognee.db

# TS lockfile — only pins dev-deps (jest, ts-jest, typescript); regeneration
# under older Node versions produces churn (lockfileVersion 1 vs 3).
ts/package-lock.json

# Python cache
__pycache__/
*.pyc
*.pyo

# Local scratch workspace files
.tmp/

# Runtime data storage (created by CLI in cwd)
.data_storage/

# Runtime artifacts written into cwd by un-isolated test runs (any directory).
# The -wal/-shm siblings appear whenever SQLite runs in WAL mode; without
# them a smoke-test run leaves two untracked files behind.
cognee.db
cognee.db-wal
cognee.db-shm
.cognee_system/

# Generated Locust benchmark artifacts
e2e-cross-sdk/performance/locust/results/
results/
ghlogs/
ios/.build/
